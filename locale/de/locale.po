msgid "plugins.generic.documentPreview.displayName"
msgstr "Dokumentvorschau"

msgid "plugins.generic.documentPreview.description"
msgstr "Ergänzt den redaktionellen Workflow um eine Vorschau eingereichter Dokumente, sodass sie ohne Herunterladen gelesen werden können. Die Umwandlung erfolgt im Browser. Formate: DOCX (mit mammoth.js)."

msgid "plugins.generic.documentPreview.preview"
msgstr "Vorschau"

msgid "plugins.generic.documentPreview.previewOf"
msgstr "Vorschau von {$name}"

msgid "plugins.generic.documentPreview.loading"
msgstr "Vorschau wird geladen …"

msgid "plugins.generic.documentPreview.error"
msgstr "Die Vorschau konnte nicht erstellt werden. Bitte laden Sie die Datei herunter."

msgid "plugins.generic.documentPreview.unsupported"
msgstr "Diese Datei kann nicht in der Vorschau angezeigt werden. Bitte laden Sie sie herunter."

msgid "plugins.generic.documentPreview.file"
msgstr "Datei"

msgid "plugins.generic.documentPreview.notice"
msgstr "Vereinfachte Vorschau: Seitenlayout, Seitenumbrüche, Kopf- und Fußzeilen sowie Kommentare werden nicht angezeigt."

msgid "plugins.generic.msWordViewer.displayName"
msgstr "MS-Word-Vorschau"

msgid "plugins.generic.msWordViewer.description"
msgstr "Ergänzt den redaktionellen Workflow um eine Vorschau eingereichter Word-Dateien (.docx), sodass sie ohne Herunterladen gelesen werden können. Die Umwandlung erfolgt im Browser mit mammoth.js."

msgid "plugins.generic.msWordViewer.preview"
msgstr "Vorschau"

msgid "plugins.generic.msWordViewer.previewOf"
msgstr "Vorschau von {$name}"

msgid "plugins.generic.msWordViewer.loading"
msgstr "Vorschau wird geladen …"

msgid "plugins.generic.msWordViewer.error"
msgstr "Die Vorschau konnte nicht erstellt werden. Bitte laden Sie die Datei herunter."

msgid "plugins.generic.msWordViewer.notDocx"
msgstr "Diese Datei ist kein Word-Dokument im Format .docx und kann nicht in der Vorschau angezeigt werden. Bitte laden Sie sie herunter."

msgid "plugins.generic.msWordViewer.notice"
msgstr "Vereinfachte Vorschau: Seitenlayout, Seitenumbrüche, Kopf- und Fußzeilen sowie Kommentare werden nicht angezeigt."

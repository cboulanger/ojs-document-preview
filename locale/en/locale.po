msgid "plugins.generic.documentPreview.displayName"
msgstr "Document Preview"

msgid "plugins.generic.documentPreview.description"
msgstr "Adds a preview of submitted documents to the editorial workflow, so that they can be read without downloading them. The conversion happens in the browser. Formats: DOCX (with mammoth.js) and OpenDocument text (ODT)."

msgid "plugins.generic.documentPreview.preview"
msgstr "Preview"

msgid "plugins.generic.documentPreview.previewOf"
msgstr "Preview of {$name}"

msgid "plugins.generic.documentPreview.loading"
msgstr "Loading preview…"

msgid "plugins.generic.documentPreview.error"
msgstr "The preview could not be created. Please download the file instead."

msgid "plugins.generic.documentPreview.unsupported"
msgstr "This file cannot be shown in the preview. Please download it instead."

msgid "plugins.generic.documentPreview.file"
msgstr "file"

msgid "plugins.generic.documentPreview.notice"
msgstr "Simplified preview: layout, page breaks, headers, footers and comments are not shown."

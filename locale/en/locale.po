msgid "plugins.generic.docxViewer.displayName"
msgstr "DOCX Viewer"

msgid "plugins.generic.docxViewer.description"
msgstr "Adds a preview of submitted DOCX documents to the editorial workflow, so that they can be read without downloading them. The conversion happens in the browser with mammoth.js."

msgid "plugins.generic.docxViewer.preview"
msgstr "Preview"

msgid "plugins.generic.docxViewer.previewOf"
msgstr "Preview of {$name}"

msgid "plugins.generic.docxViewer.loading"
msgstr "Loading preview…"

msgid "plugins.generic.docxViewer.error"
msgstr "The preview could not be created. Please download the file instead."

msgid "plugins.generic.docxViewer.notDocx"
msgstr "This file is not a DOCX document and cannot be previewed. Please download it instead."

msgid "plugins.generic.docxViewer.notice"
msgstr "Simplified preview: layout, page breaks, headers, footers and comments are not shown."
